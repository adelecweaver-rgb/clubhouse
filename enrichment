  <title>The Enrichment Program — The ISO Clubhouse</title>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=Jost:wght@200;300;400&display=swap" rel="stylesheet"/>
<style>
    :root { --green: #152b1c; --cream: #f0ead8; --cream-dim: #d8d0ba; }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--green); color: var(--cream); font-family: 'Jost', sans-serif; font-weight: 300; overflow-x: hidden; }

    /* HEADER */
    header { position: fixed; top: 0; left: 0; right: 0; z-index: 100; background: var(--green); }
    .header-title-bar {
      display: flex; align-items: center; justify-content: space-between;
      padding: 16px 24px 14px;
      border-bottom: 1px solid rgba(240,234,216,0.25);
    }
    .hamburger { display: flex; flex-direction: column; gap: 5px; cursor: pointer; width: 28px; flex-shrink: 0; }
    .hamburger span { display: block; height: 1px; background: var(--cream); width: 100%; }
    .site-title {
      font-family: 'Jost', sans-serif; font-weight: 300;
      letter-spacing: 0.2em; font-size: 16px;
      text-transform: uppercase; color: var(--cream); text-align: center;
      text-decoration: none; display: block; flex: 1;
    }
    .header-key {
      width: 28px; display: flex; align-items: center; justify-content: flex-end;
      flex-shrink: 0;
    }
    .header-key a { color: rgba(240,234,216,0.5); text-decoration: none; display: flex; align-items: center; }
    .header-key a:hover { color: var(--cream); }
    .header-key svg { width: 16px; height: 16px; }
    .status-bar {
      display: flex; justify-content: center;
      font-size: 10px; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--cream-dim);
      padding: 10px 0; font-weight: 300;
    }
    .status-bar span { padding: 0 12px; }
    .status-bar .divider { border-left: 1px solid rgba(240,234,216,0.2); padding: 0; width: 1px; }
    .siesta-timer { color: var(--cream); }

    /* MENU OVERLAY */
    .menu-overlay {
      position: fixed; inset: 0; background: var(--green); z-index: 200;
      display: flex; flex-direction: column; padding: 48px 36px;
      transform: translateX(-100%);
      transition: transform 0.35s cubic-bezier(0.76,0,0.24,1);
      overflow-y: auto;
    }
    .menu-overlay.open { transform: translateX(0); }
    .menu-close {
      align-self: flex-end; background: none; border: none;
      color: var(--cream); font-size: 24px; cursor: pointer;
      font-weight: 200; margin-bottom: 48px; flex-shrink: 0;
    }
    .menu-nav { display: flex; flex-direction: column; }
    .menu-nav > .nav-item { border-bottom: 1px solid rgba(240,234,216,0.1); }
    .menu-nav > .nav-item:last-child { border-bottom: none; }
    .nav-link {
      font-family: 'Cormorant Garamond', serif; font-size: 30px; font-weight: 300;
      color: var(--cream); text-decoration: none; letter-spacing: 0.04em;
      display: flex; align-items: center; justify-content: space-between;
      padding: 0 0 24px; margin-top: 24px; cursor: pointer;
      background: none; border: none; width: 100%; text-align: left;
    }
    .nav-link .caret {
      font-size: 13px; opacity: 0.45; font-family: 'Jost', sans-serif; font-weight: 200;
      transition: transform 0.2s ease; flex-shrink: 0; margin-left: 12px;
    }
    .nav-item.open .caret { transform: rotate(180deg); }
    .nav-sub { display: none; flex-direction: column; padding-bottom: 20px; padding-left: 2px; }
    .nav-item.open .nav-sub { display: flex; }
    .nav-sub a {
      font-family: 'Jost', sans-serif; font-size: 12px; font-weight: 300;
      color: rgba(240,234,216,0.55); text-decoration: none;
      letter-spacing: 0.2em; text-transform: uppercase;
      padding: 9px 0; border-bottom: 1px solid rgba(240,234,216,0.06);
      display: flex; align-items: center; gap: 8px;
    }
    .nav-sub a:last-child { border-bottom: none; }
    .nav-sub .lock-icon { opacity: 0.4; flex-shrink: 0; }
    .nav-sub .lock-icon svg { width: 10px; height: 10px; }

    /* FOOTER */
    footer {
      background: var(--green); color: var(--cream);
      border-top: 1px solid rgba(240,234,216,0.12);
      padding: 56px 28px 40px;
      display: flex; flex-direction: column; align-items: center; gap: 36px;
    }
    .footer-logo img { width: 64px; height: auto; display: block; }
    .footer-info { text-align: center; font-size: 11px; letter-spacing: 0.1em; line-height: 2.2; color: var(--cream-dim); text-transform: uppercase; }
    .footer-federations { display: flex; gap: 36px; align-items: center; justify-content: center; padding-top: 20px; border-top: 1px solid rgba(240,234,216,0.12); width: 100%; }
    .federation-badge { display: flex; flex-direction: column; align-items: center; gap: 8px; opacity: 0.5; }
    .federation-badge svg { width: 36px; height: 36px; }
    .federation-badge span { font-size: 8px; letter-spacing: 0.16em; text-transform: uppercase; text-align: center; line-height: 1.5; max-width: 78px; }

    .page-hero { padding: 160px 28px 72px; text-align: center; max-width: 560px; margin: 0 auto; }
    .page-label { font-family: 'Jost', sans-serif; font-weight: 300; font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--cream-dim); margin-bottom: 22px; }
    .page-title { font-family: 'Cormorant Garamond', serif; font-weight: 300; font-size: 42px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--cream); line-height: 1.1; }
    .rule { width: 40px; height: 1px; background: rgba(240,234,216,0.25); margin: 40px auto; }
    .founding-body { padding: 0 28px 80px; max-width: 560px; margin: 0 auto; }
    .founding-body p { font-family: 'Cormorant Garamond', serif; font-size: 19px; line-height: 1.9; font-weight: 400; color: rgba(240,234,216,0.85); margin-bottom: 32px; }
    .founding-body p:last-of-type { margin-bottom: 0; }
    .coda { font-style: italic; color: rgba(240,234,216,0.55) !important; font-size: 18px !important; }
    .founding-photo { width: 100%; max-width: 560px; margin: 0 auto; padding: 0 0 80px; }
    .founding-photo img { width: 100%; display: block; filter: sepia(12%) saturate(85%) brightness(0.97); }
    .photo-caption { font-family: 'Jost', sans-serif; font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(240,234,216,0.3); text-align: center; padding-top: 14px; }

    .quote-block { max-width: 460px; margin: 0 auto 64px; padding: 0 28px; text-align: center; }
    .quote-text { font-family: 'Cormorant Garamond', serif; font-style: italic; font-weight: 400; font-size: 23px; line-height: 1.55; color: rgba(240,234,216,0.92); margin-bottom: 22px; }
    .quote-attribution { font-family: 'Jost', sans-serif; font-size: 10px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cream-dim); line-height: 1.9; }
    .section-divider { display: flex; flex-direction: column; align-items: center; padding: 8px 28px 56px; }
    .section-divider .rule { margin: 0 0 28px; }
    .section-label { font-family: 'Jost', sans-serif; font-weight: 300; font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase; color: var(--cream-dim); }
    .closing-line { font-family: 'Cormorant Garamond', serif; font-style: italic; font-size: 18px; color: rgba(240,234,216,0.55); text-align: center; padding: 0 28px 8px; max-width: 560px; margin: 0 auto; }
    .signature-line { font-family: 'Jost', sans-serif; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(240,234,216,0.35); text-align: center; padding: 24px 20px 80px; max-width: 320px; margin: 0 auto; }
  
    .enrich-cta { text-align: center; padding: 8px 28px 72px; }
    .enrich-cta a { display: inline-block; font-family: 'Jost', sans-serif; font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--cream); border: 1px solid rgba(240,234,216,0.35); padding: 16px 34px; text-decoration: none; transition: background 0.2s ease, color 0.2s ease; }
    .enrich-cta a:hover { background: var(--cream); color: var(--green); }
    .enrich-photos { display: grid; grid-template-columns: repeat(3, 1fr); gap: 3px; max-width: 680px; margin: 0 auto; padding: 0 0 80px; }
    .enrich-photos .photo-slot { aspect-ratio: 1 / 1; overflow: hidden; }
    .enrich-photos img { width: 100%; height: 100%; object-fit: cover; display: block; }
  </style>
