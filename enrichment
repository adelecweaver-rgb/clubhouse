<script>
    function toggleSub(id) { document.getElementById(id).classList.toggle('open'); }
    function toggleMenu() { document.getElementById('menuOverlay').classList.toggle('open'); }
    function updateSiestaTimer() {
      const now = new Date(), siesta = new Date(now);
      siesta.setHours(14,0,0,0);
      let diff = siesta - now;
      const el = document.getElementById('siestaTimer');
      if (!el) return;
      if (diff < 0) { el.textContent = 'Siesta: underway'; return; }
      const h = Math.floor(diff/3600000); diff -= h*3600000;
      const m = Math.floor(diff/60000); diff -= m*60000;
      const s = Math.floor(diff/1000);
      const pad = n => String(n).padStart(2,'0');
      el.textContent = h > 0 ? `${h}h ${pad(m)}m to Siesta` : `${pad(m)}m ${pad(s)}s to Siesta`;
    }
    updateSiestaTimer();
    setInterval(updateSiestaTimer, 1000);
  </script>
